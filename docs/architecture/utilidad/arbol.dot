  edge [color="#718096"];
  U [label="Utilidad", fillcolor="#173c59", fontcolor=white];
  M [label="Modificabilidad"];
  D [label="Disponibilidad"];
  S [label="Seguridad"];
  R [label="Rendimiento"];
  M1 [label="Configuración distrital"];
  D1 [label="Continuidad en ruta"];
  S1 [label="Aislamiento y privilegios"];
  R1 [label="Latencia y recuperación"];
  Q1 [label="QA-01 (H,H) · Nuevo distrito\n≤ 2 días-persona, 0 cambios en consumidores"];
  Q6 [label="QA-06 (H,M) · Cambio de regla u horario\n≤ 1 día-persona, 0 cambios en los otros 11 distritos"];
  Q2 [label="QA-02 (H,H) · 20 min sin red\n0 perdidos, 0 duplicados, sincroniza ≤ 30 s"];
  Q4 [label="QA-04 (H,H) · Acceso entre distritos\n0 lecturas/escrituras cruzadas en 132 pares"];
