{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Docstring y documentación de funciones EcoRecicla AQP",
  "description": "Contrato de salida de la Tarea B del Lab09.",
  "type": "object",
  "additionalProperties": false,
  "required": ["nombre", "resumen", "docstring", "parametros", "retorno", "excepciones"],
  "properties": {
    "nombre": {"type": "string", "minLength": 1},
    "resumen": {"type": "string", "minLength": 8, "maxLength": 180},
    "docstring": {"type": "string", "minLength": 20},
    "parametros": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nombre", "descripcion"],
        "properties": {
          "nombre": {"type": "string", "minLength": 1},
          "descripcion": {"type": "string", "minLength": 5}
        }
      }
    },
    "retorno": {"type": ["string", "null"]},
    "excepciones": {"type": "array", "items": {"type": "string", "minLength": 3}}
  }
}
